{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "khelo24id.live"
        }
      ],
      "destination": "https://www.khelo24id.live/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "khelo24id.live"
        }
      ],
      "destination": "https://www.khelo24id.live/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/cricket",
      "destination": "/index.html"
    },
    {
      "source": "/aviator",
      "destination": "/index.html"
    },
    {
      "source": "/teen-patti",
      "destination": "/index.html"
    },
    {
      "source": "/blog",
      "destination": "/index.html"
    },
    {
      "source": "/blog/:slug*",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/index.html"
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/index.html"
    },
    {
      "source": "/responsible-gambling",
      "destination": "/index.html"
    },
    {
      "source": "/payment-methods",
      "destination": "/index.html"
    },
    {
      "source": "/editorial-policy",
      "destination": "/index.html"
    }
  ],
  "trailingSlash": false
